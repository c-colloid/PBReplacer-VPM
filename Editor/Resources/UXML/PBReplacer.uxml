<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:Template name="Column" src="project://database/Packages/jp.colloid.pbreplacer/Editor/Resources/UXML/PBReplacerColumn.uxml?fileID=9197481963319205126&amp;guid=87ad64a1f98a411787cb2777e5e4ab4e&amp;type=3#PBReplacerColumn" />
    <Style src="project://database/Packages/jp.colloid.pbreplacer/Editor/Resources/USS/PBReplacerCommon.uss?fileID=7433441132597879392&amp;guid=93c673357a8947738951515276961893&amp;type=3#PBReplacerCommon" />
    <Style src="project://database/Packages/jp.colloid.pbreplacer/Editor/Resources/USS/PBReplacer.uss?fileID=7433441132597879392&amp;guid=315c19ce5d24dfb4ba0de347a8fe18a1&amp;type=3#PBReplacer" />

    <ui:VisualElement name="window" class="pbr-window">

        <!-- ツール行（↻ 再読み込み / ↶ 元に戻す / ⚙ 詳細設定 / ⋮ その他）。アイコン画像は Unity 内蔵なので C# で設定 -->
        <ui:VisualElement name="tools" class="pbr-tools">
            <ui:Button name="tool-reload" class="pbr-icon-button" tooltip="再読み込み"><ui:Image name="tool-reload-icon" class="pbr-icon" /></ui:Button>
            <ui:Button name="tool-undo" class="pbr-icon-button" tooltip="直前の再配置を元に戻す (Ctrl+Z)"><ui:Image name="tool-undo-icon" class="pbr-icon" /></ui:Button>
            <ui:Button name="tool-gear" class="pbr-icon-button" tooltip="詳細設定"><ui:Image name="tool-gear-icon" class="pbr-icon" /></ui:Button>
            <ui:Button name="tool-menu" class="pbr-icon-button" tooltip="その他"><ui:Image name="tool-menu-icon" class="pbr-icon" /></ui:Button>
        </ui:VisualElement>

        <!-- 流れ: [アバター] ──(再配置 n →)── [AvatarDynamics]  左→右 = 再配置の向き -->
        <ui:VisualElement name="strip" class="pbr-strip">
            <ui:VisualElement name="node-avatar" class="pbr-node pbr-node--clickable" tooltip="アバターをドロップ、またはクリックで選択">
                <ui:VisualElement class="pbr-node-iconwrap">
                    <ui:Image name="node-avatar-icon" class="pbr-node-icon" />
                    <ui:Image name="node-avatar-badge" class="pbr-node-badge" />
                </ui:VisualElement>
                <ui:VisualElement class="pbr-node-text">
                    <ui:Label name="node-avatar-name" class="pbr-node-name" />
                    <ui:Label name="node-avatar-sub" class="pbr-node-sub" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="connector" class="pbr-connector">
                <ui:VisualElement name="line-left" class="pbr-line" />
                <ui:Button name="apply-button" class="pbr-apply">
                    <ui:Label name="apply-label" text="再配置" class="pbr-apply-label" />
                    <ui:Image name="apply-icon" class="pbr-apply-icon" />
                </ui:Button>
                <ui:Image name="connector-state" class="pbr-connector-state" style="display: none;" />
                <ui:VisualElement name="line-right" class="pbr-line" />
            </ui:VisualElement>

            <ui:VisualElement name="node-dynamics" class="pbr-node pbr-node--clickable">
                <ui:VisualElement class="pbr-node-iconwrap">
                    <ui:Image name="node-dynamics-icon" class="pbr-node-icon" />
                </ui:VisualElement>
                <ui:VisualElement class="pbr-node-text">
                    <ui:Label name="node-dynamics-name" class="pbr-node-name" text="AvatarDynamics" />
                    <ui:Label name="node-dynamics-sub" class="pbr-node-sub" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 詳細設定（⚙ で開閉。保存先ごとに見出し） -->
        <ui:VisualElement name="advanced" class="pbr-advanced" style="display: none;">
            <ui:Label text="プロジェクト設定 — チームで共有 (ProjectSettings/)" class="pbr-advanced-section" />
            <uie:EnumField name="setting-find-component" label="検索範囲" type="colloid.PBReplacer.FindComponent, jp.colloid.pbreplacer" tooltip="再配置の対象を探す階層" />
            <ui:Toggle name="setting-destroy-unused" class="pbr-switch" label="再配置後、空になったフォルダを削除" />
            <ui:VisualElement class="pbr-advanced-row">
                <ui:Toggle name="setting-unpack-prefab" class="pbr-switch" label="再配置前に Prefab を完全に Unpack" />
                <ui:Label text="元に戻せません" class="pbr-advanced-note" />
            </ui:VisualElement>

            <ui:Label text="個人設定 — この PC のみ (EditorPrefs)" class="pbr-advanced-section" />
            <ui:Toggle name="setting-auto-load" class="pbr-switch" label="前回のアバターを自動で読み込む" />
            <ui:Toggle name="setting-confirm" class="pbr-switch" label="再配置・移植の前に確認する" tooltip="メインウィンドウの再配置と PBRemap の移植（→）で共通。どちらも Ctrl+Z で元に戻せるため既定はオフ" />
            <ui:VisualElement name="setting-skip-row" class="pbr-advanced-row">
                <ui:Toggle name="setting-skip-small" class="pbr-switch" label="　未処理が" />
                <uie:IntegerField name="setting-skip-threshold" value="5" />
                <ui:Label text="件以下なら確認を省略" />
            </ui:VisualElement>

            <ui:VisualElement class="pbr-advanced-footer">
                <ui:Label name="version-label" class="pbr-advanced-version" />
                <ui:Button name="setting-reset" text="初期値に戻す…" class="pbr-link-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- レール（カテゴリのアイコンチップ。枠色=状態、右下バッジ=未処理件数）+ 列（カテゴリごとの一覧）。
             アイコン画像・件数・一覧データは C# がバインドする -->
        <ui:VisualElement name="body" class="pbr-body">
            <ui:VisualElement name="rail" class="pbr-rail">
            <ui:VisualElement name="chip-PhysBone" class="pbr-rail-chip">
                <ui:Image name="chip-PhysBone-icon" class="pbr-rail-chip-icon" />
                <ui:Label name="chip-PhysBone-badge" class="pbr-rail-badge" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="chip-PhysBoneCollider" class="pbr-rail-chip">
                <ui:Image name="chip-PhysBoneCollider-icon" class="pbr-rail-chip-icon" />
                <ui:Label name="chip-PhysBoneCollider-badge" class="pbr-rail-badge" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="chip-Constraint" class="pbr-rail-chip">
                <ui:Image name="chip-Constraint-icon" class="pbr-rail-chip-icon" />
                <ui:Label name="chip-Constraint-badge" class="pbr-rail-badge" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="chip-Contact" class="pbr-rail-chip">
                <ui:Image name="chip-Contact-icon" class="pbr-rail-chip-icon" />
                <ui:Label name="chip-Contact-badge" class="pbr-rail-badge" picking-mode="Ignore" />
            </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="columns" class="pbr-columns">
            <ui:Instance template="Column" class="pbr-column-slot" name="column-PhysBone">
                <AttributeOverrides element-name="title" text="PhysBone" />
            </ui:Instance>
            <ui:Instance template="Column" class="pbr-column-slot" name="column-PhysBoneCollider">
                <AttributeOverrides element-name="title" text="PhysBone Collider" />
            </ui:Instance>
            <ui:Instance template="Column" class="pbr-column-slot" name="column-Constraint">
                <AttributeOverrides element-name="title" text="Constraint" />
            </ui:Instance>
            <ui:Instance template="Column" class="pbr-column-slot" name="column-Contact">
                <AttributeOverrides element-name="title" text="Contact" />
            </ui:Instance>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
