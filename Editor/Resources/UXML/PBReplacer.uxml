                </ui:VisualElement>
                <ui:VisualElement name="chip-Contact" class="pbr-rail-chip">
                    <ui:Image name="chip-Contact-icon" class="pbr-rail-chip-icon" />
                    <ui:Label name="chip-Contact-badge" picking-mode="Ignore" class="pbr-rail-badge" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="columns" class="pbr-columns">
                <ui:Instance template="Column" name="column-PhysBone" class="pbr-column-slot">
                    <AttributeOverrides element-name="title" text="PhysBone" />
                </ui:Instance>
                <ui:Instance template="Column" name="column-PhysBoneCollider" class="pbr-column-slot">
                    <AttributeOverrides element-name="title" text="PhysBone Collider" />
                </ui:Instance>
                <ui:Instance template="Column" name="column-Constraint" class="pbr-column-slot">
                    <AttributeOverrides element-name="title" text="Constraint" />
                </ui:Instance>
                <ui:Instance template="Column" name="column-Contact" class="pbr-column-slot">
                    <AttributeOverrides element-name="title" text="Contact" />
                </ui:Instance>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
