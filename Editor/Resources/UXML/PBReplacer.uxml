            </ui:VisualElement>
            <ui:VisualElement class="pbr-advanced-footer">
                <ui:Label name="version-label" class="pbr-advanced-version" />
                <ui:Button name="setting-reset" text="初期値に戻す…" class="pbr-link-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="body" class="pbr-body">
            <ui:VisualElement name="rail" class="pbr-rail">
                <ui:VisualElement name="chip-PhysBone" class="pbr-rail-chip">
                    <ui:Image name="chip-PhysBone-icon" class="pbr-rail-chip-icon" />
                    <ui:Label name="chip-PhysBone-badge" picking-mode="Ignore" class="pbr-rail-badge" />
                </ui:VisualElement>
                <ui:VisualElement name="chip-PhysBoneCollider" class="pbr-rail-chip">
                    <ui:Image name="chip-PhysBoneCollider-icon" class="pbr-rail-chip-icon" />
                    <ui:Label name="chip-PhysBoneCollider-badge" picking-mode="Ignore" class="pbr-rail-badge" />
                </ui:VisualElement>
                <ui:VisualElement name="chip-Constraint" class="pbr-rail-chip">
                    <ui:Image name="chip-Constraint-icon" class="pbr-rail-chip-icon" />
