<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <!-- 一覧の 1 行: [畳み記号] [状態アイコン] 名前 … [ホバー操作: Hierarchy で表示 / 削除]。
         配置済みの見出し行も同じ行を使い、C# がクラスと表示を切り替える -->
    <ui:VisualElement name="row" class="pbr-row">
        <ui:Image name="fold" class="pbr-row-fold" style="display: none;" />
        <ui:Image name="state" class="pbr-row-icon" />
        <ui:Label name="name" class="pbr-row-name" />
        <ui:VisualElement name="actions" class="pbr-row-actions">
            <ui:Button name="action-ping" class="pbr-icon-button pbr-row-action" tooltip="Hierarchy で表示"><ui:Image name="action-ping-icon" class="pbr-icon pbr-row-action-icon" /></ui:Button>
            <ui:Button name="action-delete" class="pbr-icon-button pbr-row-action" tooltip="このコンポーネントを削除"><ui:Image name="action-delete-icon" class="pbr-icon pbr-row-action-icon" /></ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
