<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">

    <Style src="project://database/Packages/jp.colloid.pbreplacer/Editor/Resources/USS/PBReplacerCommon.uss?fileID=7433441132597879392&amp;guid=93c673357a8947738951515276961893&amp;type=3#PBReplacerCommon" />
    <Style src="project://database/Packages/jp.colloid.pbreplacer/Editor/Resources/USS/PBRemap.uss?fileID=7433441132597879392&amp;guid=d2599c9a80cec7b45a0eb873e03b097b&amp;type=3#PBRemap" />
    <Style src="project://database/Packages/jp.colloid.pbreplacer/Editor/Resources/USS/PBReplacer.uss?fileID=7433441132597879392&amp;guid=315c19ce5d24dfb4ba0de347a8fe18a1&amp;type=3#PBReplacer" />

    <!-- ツール（参照情報更新 / SceneViewプレビュー / 詳細設定）。アイコン画像は Unity 内蔵なので C# で設定 -->
    <ui:VisualElement name="tools" class="pbremap-tools">
        <ui:Button name="tool-refresh" class="pbremap-icon-button" tooltip="参照情報を取り直す（移植元にいるときだけ）"><ui:Image name="tool-refresh-icon" class="pbremap-icon" /></ui:Button>
        <ui:Button name="tool-eye" class="pbremap-icon-button" tooltip="SceneView に対応線を表示"><ui:Image name="tool-eye-icon" class="pbremap-icon" /></ui:Button>
        <ui:Button name="tool-gear" class="pbremap-icon-button" tooltip="詳細設定"><ui:Image name="tool-gear-icon" class="pbremap-icon" /></ui:Button>
    </ui:VisualElement>

    <!-- 流れ: [移植元] ──(移植)──▶ [移植先]  左→右 = ドラッグの向き -->
    <ui:VisualElement name="strip" class="pbremap-strip">
        <ui:VisualElement name="node-src" class="pbremap-node">
            <ui:VisualElement class="pbremap-node-iconwrap">
                <ui:Image name="node-src-icon" class="pbremap-node-icon" />
                <ui:Image name="node-src-badge" class="pbremap-node-badge" />
            </ui:VisualElement>
            <ui:VisualElement class="pbremap-node-text">
                <ui:Label name="node-src-name" class="pbremap-node-name" />
                <ui:Label name="node-src-sub" class="pbremap-node-sub" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="connector" class="pbremap-connector">
            <ui:VisualElement name="line-left" class="pbremap-line" />
            <ui:Button name="apply-button" class="pbremap-apply">
                <ui:Label name="apply-label" text="移植" class="pbremap-apply-label" />
                <ui:Image name="apply-icon" class="pbremap-apply-icon" />
            </ui:Button>
            <ui:Image name="connector-state" class="pbremap-connector-state" />
            <ui:VisualElement name="line-right" class="pbremap-line" />
        </ui:VisualElement>

        <ui:VisualElement name="node-dst" class="pbremap-node pbremap-node--dst">
            <ui:VisualElement class="pbremap-node-iconwrap">
                <ui:Image name="node-dst-icon" class="pbremap-node-icon" />
                <ui:Image name="node-dst-badge" class="pbremap-node-badge" />
            </ui:VisualElement>
            <ui:VisualElement class="pbremap-node-text">
                <ui:Label name="node-dst-name" class="pbremap-node-name" />
                <ui:Label name="node-dst-sub" class="pbremap-node-sub" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- 移植先が見つからないときの候補（クリックで移動） -->
    <ui:VisualElement name="candidates" class="pbremap-candidates" style="display: none;" />

    <!-- 本当に注意が必要なときだけ -->
    <ui:HelpBox name="warning-box" style="display: none;" />

    <!-- Console 風の件数チップ（クリックで表の絞り込み） + スケール -->
    <ui:VisualElement name="chips" class="pbremap-chips" style="display: none;" />

    <!-- ボーン対応表（問題のある行だけを既定表示） -->
    <ui:VisualElement name="mapping-table" class="pbremap-table" style="display: none;" />

    <!-- 結果/エラー -->
    <ui:HelpBox name="status-box" style="display: none;" />

    <!-- 詳細設定（歯車で開閉） -->
    <ui:VisualElement name="advanced" class="pbremap-advanced" style="display: none;">
        <uie:EnumField name="apply-mode-field" label="ドロップ時" binding-path="applyMode" tooltip="AutoOnDrop: 全て一意に解決できれば自動で移植&#10;Confirm: 置いた後、Inspector の → で移植&#10;BuildOnly: 編集時は何もせず NDMF ビルド時に適用（非破壊）" />
        <ui:VisualElement name="scale-row" class="pbremap-scale-row">
            <uie:EnumField name="scale-mode-field" label="スケール" binding-path="scaleMode" tooltip="Auto: Hips-Head 距離比 → ボーン間距離比&#10;Manual: 世界寸法比を手入力&#10;None: 補正しない" />
            <uie:FloatField name="scale-factor-field" binding-path="manualScaleFactor" class="pbremap-scale-factor" />
        </ui:VisualElement>

        <ui:Foldout name="remap-rules-foldout" text="名前の対応ルール" value="false" tooltip="ボーン名やパスが異なるアバター間の移植時に使用します。ルールは双方向に適用されます。">
            <ui:VisualElement name="remap-rules-toolbar" class="pbremap-rules-toolbar">
                <ui:Button name="toggle-hints-button" text="?" tooltip="ルールごとのヒント表示を切り替え" class="pbremap-hint-toggle-button" />
                <ui:Button name="add-rule-button" class="pbremap-add-button" tooltip="ルールを追加" />
            </ui:VisualElement>
            <ui:ListView name="remap-rules-list" show-foldout-header="false" reorder-mode="Animated" show-add-remove-footer="false" />
        </ui:Foldout>

        <ui:Foldout name="manual-override-foldout" text="手動指定" value="false" tooltip="自動検出が正しく動作しない場合に移植元/移植先を手動で指定します。">
            <uie:ObjectField name="source-root-override" label="移植元" binding-path="sourceRootOverride" />
            <uie:ObjectField name="dest-root-override" label="移植先" binding-path="destinationRootOverride" />
        </ui:Foldout>

        <ui:Foldout name="manifest-foldout" text="参照情報" value="false">
            <ui:Label name="manifest-info" class="pbremap-manifest-info" />
        </ui:Foldout>
    </ui:VisualElement>

    <!-- 文字列リソース（ルールのヒント/ツールチップ。UIには直接表示されない） -->
    <ui:VisualElement name="string-resources" style="display: none;">
        <ui:Label name="str-hint-prefix-replace" text="ボーン名の先頭を双方向で置換。空欄で接頭辞を除去/追加&#10;例: [J_Bip_C_] ↔ [] → J_Bip_C_Hips ↔ Hips" />
        <ui:Label name="str-hint-char-substitution" text="ボーン名内の文字列を双方向で全置換  例: [_L] ↔ [.L]" />
        <ui:Label name="str-hint-regex-replace" text="左欄=正規表現パターン  右欄=置換文字列（双方向）&#10;例: [Bone(\d+)] ↔ [B$1]" />
        <ui:Label name="str-tooltip-prefix-source" text="移植元の接頭辞（空欄 = 接頭辞なし）" />
        <ui:Label name="str-tooltip-prefix-dest" text="移植先の接頭辞（空欄 = 接頭辞なし）" />
        <ui:Label name="str-tooltip-char-source" text="移植元の文字列" />
        <ui:Label name="str-tooltip-char-dest" text="移植先の文字列" />
        <ui:Label name="str-tooltip-regex-source" text="正規表現パターン（例: Bone(\d+)）" />
        <ui:Label name="str-tooltip-regex-dest" text="置換文字列（例: B$1）。$1 でキャプチャグループ参照" />
        <ui:Label name="str-dialog-title" text="コンポーネント移植" />
        <ui:Label name="str-dialog-confirm-template" text="移植元: {0}&#10;移植先: {1}&#10;&#10;移植を実行しますか？&#10;（コンポーネントのボーン参照がリマップされます）" />
        <ui:Label name="str-dialog-ok" text="実行" />
        <ui:Label name="str-dialog-cancel" text="キャンセル" />
    </ui:VisualElement>
</ui:UXML>
