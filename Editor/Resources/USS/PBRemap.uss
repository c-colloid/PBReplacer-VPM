/* ============================================================
   PBRemap Inspector
   流れ（strip）: [移植元] ──(移植)──▶ [移植先]
   状態は色とアイコンで伝え、文字は オブジェクト名 / 数値 / 動詞1語 に限る
   strip / node / apply / chip / icon-button / advanced は PBReplacerCommon.uss に共通化
   ============================================================ */

/* ---- 候補（移植先が見つからないとき） ---- */
.pbremap-candidates {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin: 0 4px 4px 4px;
}

.pbremap-candidate {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0 8px 0 4px;
    margin: 2px 4px 2px 0;
    border-radius: 11px;
}

.pbremap-candidate > Label {
    margin-left: 4px;
}

/* ---- チップ（Console 風のフィルタ） ---- */

.pbremap-chip--scale {
    margin-left: auto;
}

.pbremap-chip-field {
    width: 56px;
    margin: 0 0 0 2px;
}

/* ---- ボーン対応表 ---- */
.pbremap-table {
    margin: 0 2px 4px 2px;
}

.pbremap-row {
    flex-direction: row;
    align-items: center;
    padding: 1px 4px;
    margin-bottom: 1px;
    border-radius: 3px;
}

.pbremap-row--unresolved {
    background-color: rgba(220, 80, 80, 0.10);
}

.pbremap-row--ambiguous {
    background-color: rgba(220, 180, 50, 0.10);
}

.pbremap-row--auto {
    background-color: rgba(220, 180, 50, 0.06);
}

.pbremap-row-icon {
    width: 14px;
    height: 14px;
    margin-right: 4px;
}

.pbremap-row-src {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
    font-size: 11px;
}

.pbremap-row-src--outer {
    -unity-font-style: italic;
}

.pbremap-row-arrow {
    width: 14px;
    height: 14px;
    margin: 0 2px;
    opacity: 0.6;
}

.pbremap-row > ObjectField {
    flex-grow: 1.3;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 96px;
    margin: 0 2px;
}

.pbremap-row--unresolved > ObjectField > .unity-object-field__input {
    border-color: rgba(220, 80, 80, 0.7);
}

.pbremap-row-action {
    width: 22px;
    height: 18px;
    padding: 0;
    margin: 0 0 0 2px;
    align-items: center;
    justify-content: center;
}

.pbremap-row-ghost {
    font-size: 11px;
    color: rgb(220, 180, 50);
    margin-left: 2px;
    flex-shrink: 0;
}

/* ---- 詳細設定 ---- */

.pbremap-scale-row {
    flex-direction: row;
    align-items: center;
}

.pbremap-scale-row > EnumField {
    flex-grow: 1;
}

.pbremap-scale-factor {
    width: 70px;
}

.pbremap-manifest-info {
    font-size: 10px;
    color: rgb(160, 160, 160);
    white-space: normal;
    margin: 2px 4px;
}

.pbremap-rules-toolbar {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 4px;
}

.pbremap-hint-toggle-button {
    width: 22px;
    height: 20px;
    margin-right: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    border-radius: 3px;
}

.pbremap-hint-toggle-button-active {
    background-color: rgba(100, 200, 100, 0.2);
    color: rgb(100, 200, 100);
}

.pbremap-add-button {
    width: 26px;
    height: 20px;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.remap-rule-item {
    flex-direction: row;
    align-items: center;
    padding: 2px;
    margin-bottom: 1px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(85, 85, 85, 0.3);
}

.remap-rule-item > Toggle {
    width: 20px;
    flex-shrink: 0;
    margin-right: 2px;
}

.remap-rule-item > EnumField {
    width: 110px;
    flex-shrink: 0;
    margin-right: 2px;
}

.remap-rule-item > TextField {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 2px;
    min-width: 40px;
}

.remap-rule-arrow {
    -unity-text-align: middle-center;
    width: 20px;
    flex-shrink: 0;
}

.remap-rule-delete-button {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    align-items: center;
    justify-content: center;
}

.remap-rule-hint {
    font-size: 10px;
    color: rgb(140, 140, 140);
    padding: 0 4px 2px 24px;
}

.remap-rule-error {
    border-left-width: 2px;
    border-left-color: rgb(220, 80, 80);
    background-color: rgba(220, 80, 80, 0.08);
}

.remap-rule-error-label {
    font-size: 10px;
    color: rgb(220, 80, 80);
    padding: 0 4px 2px 24px;
    white-space: normal;
}

/* ---- プレビューウィンドウ（共有） ---- */
.preview-summary-label {
    -unity-font-style: bold;
    padding: 4px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(85, 85, 85, 0.5);
}

.preview-filter-bar {
    flex-direction: row;
    padding: 2px 4px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(85, 85, 85, 0.5);
    flex-shrink: 0;
}

.preview-filter-toggle {
    flex-direction: row;
    align-items: center;
    margin-right: 4px;
    padding: 2px 8px 2px 4px;
    border-radius: 10px;
    border-width: 1px;
    cursor: link;
}

.preview-filter-toggle:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.preview-filter-toggle-active {
    border-color: rgba(255, 255, 255, 0.2);
}

.preview-filter-toggle-inactive {
    border-color: rgba(255, 255, 255, 0.06);
    opacity: 0.5;
}

.preview-filter-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 4px;
    flex-shrink: 0;
}

.preview-filter-label {
    font-size: 11px;
    -unity-text-align: middle-left;
    overflow: hidden;
}

.preview-bone-item {
    flex-direction: row;
    padding-right: 4px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 4px;
}

.preview-bone-item > Label {
    white-space: normal;
    flex-basis: 0;
}

.preview-bone-sourcelabel {
    flex-grow: 1;
}

.preview-bone-arrow {
    font-size: 13px;
    flex-grow: 0.2;
}

.preview-bone-destlabel {
    flex-grow: 1;
}

.preview-bone-actions {
    width: 24px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}

.preview-bone-action-button {
    width: 22px;
    height: 18px;
    font-size: 12px;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.preview-bone-destlabel:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 2px;
}

.preview-bone-resolved {
    color: var(--unity-colors-default-text);
    font-size: 11px;
}

.preview-bone-auto-creatable {
    color: rgb(220, 180, 50);
    font-size: 11px;
}

.preview-bone-auto-creatable > Label {
    color: rgb(220, 180, 50);
}

.preview-bone-unresolved {
    color: rgb(220, 80, 80);
    font-size: 11px;
}

.preview-bone-unresolved > Label {
    color: rgb(220, 80, 80);
}

.preview-warning-item {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
}

.preview-warning-item > Label {
    font-size: 11px;
    color: rgb(220, 180, 50);
    flex-grow: 1;
    white-space: normal;
}

/* 詳細設定内の Foldout/Toggle は共通スタイル（緑・太字）を使わず標準の見た目にする */
.pbremap-advanced .unity-toggle__text {
    color: var(--unity-colors-label-text);
    -unity-font-style: normal;
}

/* ============================================================
   ライトテーマ（.pbr-theme-light はルートに PBReplacerTheme.Apply が付ける）
   共通語彙は PBReplacerCommon.uss。ここは PBRemap Inspector / プレビュー固有の色だけ
   ============================================================ */

.pbr-theme-light .pbremap-row--unresolved {
    background-color: rgba(200, 50, 50, 0.10);
}

.pbr-theme-light .pbremap-row--ambiguous {
    background-color: rgba(200, 140, 0, 0.12);
}

.pbr-theme-light .pbremap-row--auto {
    background-color: rgba(200, 140, 0, 0.07);
}

.pbr-theme-light .pbremap-row--unresolved > ObjectField > .unity-object-field__input {
    border-color: rgba(200, 50, 50, 0.8);
}

.pbr-theme-light .pbremap-row-ghost {
    color: rgb(160, 105, 0);
}

.pbr-theme-light .pbremap-manifest-info {
    color: rgb(100, 100, 100);
}

.pbr-theme-light .pbremap-hint-toggle-button-active {
    background-color: rgba(40, 150, 80, 0.2);
    color: rgb(30, 120, 50);
}

.pbr-theme-light .remap-rule-hint {
    color: rgb(110, 110, 110);
}

.pbr-theme-light .remap-rule-error {
    border-left-color: rgb(200, 50, 50);
    background-color: rgba(200, 50, 50, 0.08);
}

.pbr-theme-light .remap-rule-error-label {
    color: rgb(190, 40, 40);
}

.pbr-theme-light .preview-filter-toggle:hover {
    background-color: rgba(0, 0, 0, 0.06);
}

.pbr-theme-light .preview-filter-toggle-active {
    border-color: rgba(0, 0, 0, 0.30);
}

.pbr-theme-light .preview-filter-toggle-inactive {
    border-color: rgba(0, 0, 0, 0.10);
}

.pbr-theme-light .preview-bone-destlabel:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

.pbr-theme-light .preview-bone-auto-creatable,
.pbr-theme-light .preview-bone-auto-creatable > Label,
.pbr-theme-light .preview-warning-item > Label {
    color: rgb(160, 105, 0);
}

.pbr-theme-light .preview-bone-unresolved,
.pbr-theme-light .preview-bone-unresolved > Label {
    color: rgb(190, 40, 40);
}
