/* ============================================================
   PBReplacer メインウィンドウ
   流れ（strip）: [アバター] ──(再配置 n →)── [AvatarDynamics]
   左のレール: カテゴリのアイコンチップ（Console のフィルタと同じ操作）
   右の列: カテゴリごとの一覧（→ 未処理 / ✔ 配置済み）
   共通語彙（strip / chip / icon-button / advanced）は PBReplacerCommon.uss
   ============================================================ */

.unity-text-element {
    -unity-font-definition: resource('Font/Noto_Sans_JP/NotoSansJP-VariableFont_wght SDF');
}

ObjectFieldDisplay {
    flex-shrink: 1;
}

ObjectFieldSelector {
    flex-shrink: 0;
}

/* ---- 全体 ---- */
.pbr-window {
    flex-grow: 1;
    padding: 2px 4px 4px 4px;
}

/* ---- 流れ: メインウィンドウ固有の上書き ---- */
.pbr-window .pbr-strip {
    margin-bottom: 4px;
}

.pbr-node--clickable:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.pbr-window .pbr-connector {
    width: 150px;
}

.pbr-apply--hidden {
    display: none;
}

/* ---- 詳細設定（行内） ---- */
.pbr-advanced-section {
    font-size: 10px;
    letter-spacing: 0.5px;
    opacity: 0.6;
    margin: 4px 2px 1px 2px;
}

.pbr-advanced .unity-toggle {
    margin-left: 2px;
}

.pbr-advanced .unity-base-field__label {
    min-width: 160px;
}

.pbr-advanced-row {
    flex-direction: row;
    align-items: center;
}

.pbr-advanced-row > .unity-integer-field {
    width: 48px;
    margin: 0 4px;
}

.pbr-advanced-note {
    font-size: 10px;
    color: rgb(220, 180, 50);
    margin-left: 4px;
}

.pbr-advanced-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 4px;
}

.pbr-advanced-version {
    font-size: 10px;
    opacity: 0.5;
}

.pbr-link-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0 4px;
    font-size: 10px;
    color: rgb(90, 160, 255);
}

.pbr-link-button:hover {
    color: rgb(140, 190, 255);
}

/* ---- レール + 列 ---- */
.pbr-body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.35);
    border-radius: 3px;
}

.pbr-rail {
    width: 40px;
    flex-shrink: 0;
    align-items: center;
    padding: 6px 0;
    background-color: rgba(0, 0, 0, 0.12);
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.35);
}

.pbr-rail-chip {
    width: 28px;
    height: 28px;
    margin-bottom: 8px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.04);
    overflow: visible;
}

.pbr-rail-chip:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.pbr-rail-chip--off {
    opacity: 0.35;
}

.pbr-rail-chip--pending {
    border-color: rgba(220, 180, 50, 0.6);
}

.pbr-rail-chip--done {
    border-color: rgba(100, 200, 100, 0.5);
}

.pbr-rail-chip-icon {
    width: 16px;
    height: 16px;
}

/* フォールバックアイコンのとき: アイコン＋件数の 2 段（案 ii） */
.pbr-rail-chip--fallback {
    width: 38px;
    height: 38px;
}

.pbr-rail-chip--fallback .pbr-rail-chip-icon {
    margin-top: -4px;
}

.pbr-rail-chip--fallback .pbr-rail-badge {
    position: relative;
    right: 0;
    bottom: 0;
    margin-top: -2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.pbr-rail--fallback {
    width: 50px;
}

.pbr-rail-badge {
    position: absolute;
    right: -7px;
    bottom: -7px;
    min-width: 16px;
    height: 14px;
    padding: 0 4px;
    border-radius: 7px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
    background-color: rgb(58, 58, 58);
    font-size: 9px;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
}

.pbr-rail-badge--pending {
    background-color: rgb(190, 140, 40);
    border-color: rgba(0, 0, 0, 0);
    color: white;
}

.pbr-rail-badge--done {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(100, 200, 100);
    color: rgb(100, 200, 100);
}

.pbr-columns {
    flex-grow: 1;
    flex-direction: row;
    min-width: 0;
    min-height: 0;
}

.pbr-column {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.35);
    border-top-width: 2px;
    border-top-color: rgba(0, 0, 0, 0);
}

.pbr-column--last {
    border-right-width: 0;
}

.pbr-column--drop-hover {
    border-top-color: rgba(90, 160, 255, 0.9);
    background-color: rgba(90, 160, 255, 0.10);
}

.pbr-column-header {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0 6px;
    background-color: rgba(255, 255, 255, 0.04);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.35);
}

.pbr-column-header-icon {
    width: 14px;
    height: 14px;
    margin-right: 4px;
}

.pbr-column-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex-shrink: 1;
    min-width: 0;
}

.pbr-column-count {
    margin-left: 6px;
    font-size: 10px;
    opacity: 0.6;
    white-space: nowrap;
}

.pbr-column-dropzone {
    margin-left: auto;
    width: 18px;
    height: 16px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.28);
    align-items: center;
    justify-content: center;
    opacity: 0.6;
}

.pbr-column-dropzone > Image {
    width: 10px;
    height: 10px;
}

.pbr-column .unity-list-view {
    flex-grow: 1;
}

.pbr-column .unity-list-view__empty-label {
    display: none;
}

.pbr-column .unity-collection-view__item {
    padding: 0;
}

.pbr-column-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 12px;
}

.pbr-column-empty > Image {
    width: 20px;
    height: 20px;
    opacity: 0.35;
}

/* ---- 行 ---- */
.pbr-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 6px 0 4px;
}

.pbr-row-icon {
    width: 12px;
    height: 12px;
    margin-right: 4px;
    flex-shrink: 0;
}

.pbr-row-name {
    color: var(--unity-colors-default-text);
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.pbr-row--done .pbr-row-name {
    opacity: 0.55;
}

.pbr-row--done .pbr-row-icon {
    opacity: 0.8;
}

.pbr-row--header {
    background-color: rgba(0, 0, 0, 0.18);
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.35);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.35);
}

.pbr-row--header .pbr-row-name {
    font-size: 10px;
    opacity: 0.7;
}

.pbr-row-fold {
    width: 10px;
    height: 10px;
    margin-right: 2px;
    flex-shrink: 0;
    opacity: 0.6;
}
