/* ============================================================
   PBReplacer メインウィンドウ
   流れ（strip）: [アバター] ──(再配置 n →)── [AvatarDynamics]
   左のレール: カテゴリのアイコンチップ（Console のフィルタと同じ操作）
   右の列: カテゴリごとの一覧（○ 未処理 / ✔ 配置済み）
   共通語彙（strip / chip / icon-button / advanced）は PBReplacerCommon.uss
   ============================================================ */

/* フォントは PBReplacerFonts.Apply(root) がルートにインラインで適用し、子へ継承させる（USS で各要素に指定すると継承を壊すため書かない） */

ObjectFieldDisplay {
    flex-shrink: 1;
}

ObjectFieldSelector {
    flex-shrink: 0;
}

/* ---- 全体 ---- */
.pbr-window {
    flex-grow: 1;
    padding: 2px 4px 4px 4px;
}

/* ---- 流れ: メインウィンドウ固有の上書き ---- */
.pbr-window .pbr-strip {
    margin-bottom: 4px;
}

.pbr-node--clickable:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.pbr-window .pbr-connector {
    width: 150px;
}

.pbr-apply--hidden {
    display: none;
}

/* ---- 詳細設定（行内）。1 行 = [ラベル … 操作]。行の語彙 .pbr-setting は PBReplacerCommon.uss ---- */
.pbr-window .pbr-advanced {
    padding: 2px 8px 6px 8px;
}

.pbr-advanced-section {
    font-size: 10px;
    letter-spacing: 0.5px;
    opacity: 0.55;
    margin: 8px 0 2px 0;
}

/* USS には :first-child が無い（Unity がエラーを出す）ので、先頭の見出しはクラスで指定 */
.pbr-advanced-section--first {
    margin-top: 4px;
}

.pbr-advanced-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
}

.pbr-advanced-version {
    font-size: 10px;
    opacity: 0.5;
}

.pbr-link-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0 4px;
    font-size: 10px;
    color: rgb(90, 160, 255);
}

.pbr-link-button:hover {
    color: rgb(140, 190, 255);
}

/* ---- レール + 列 ---- */
.pbr-body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.35);
    border-radius: 3px;
}

.pbr-rail {
    width: 40px;
    flex-shrink: 0;
    align-items: center;
    padding: 6px 0;
    background-color: rgba(0, 0, 0, 0.12);
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.35);
}

.pbr-rail-chip {
    width: 28px;
    height: 28px;
    margin-bottom: 8px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.04);
    overflow: visible;
}

.pbr-rail-chip:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.pbr-rail-chip--off {
    opacity: 0.35;
}

.pbr-rail-chip--pending {
    border-color: rgba(220, 180, 50, 0.6);
}

.pbr-rail-chip--done {
    border-color: rgba(100, 200, 100, 0.5);
}

.pbr-rail-chip-icon {
    width: 16px;
    height: 16px;
}

.pbr-rail-badge {
    position: absolute;
    right: -7px;
    bottom: -7px;
    min-width: 16px;
    height: 14px;
    padding: 0 4px;
    border-radius: 7px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
    background-color: rgb(58, 58, 58);
    font-size: 9px;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
}

.pbr-rail-badge--pending {
    background-color: rgb(190, 140, 40);
    border-color: rgba(0, 0, 0, 0);
    color: white;
}

.pbr-rail-badge--done {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(100, 200, 100);
    color: rgb(100, 200, 100);
}

.pbr-columns {
    flex-grow: 1;
    flex-direction: row;
    min-width: 0;
    min-height: 0;
}

/* UXML の Instance（テンプレートの入れ物）。列本体 .pbr-column はこの中で伸びる */
.pbr-column-slot {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
}

.pbr-column {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.35);
    border-top-width: 2px;
    border-top-color: rgba(0, 0, 0, 0);
}

.pbr-column--last {
    border-right-width: 0;
}

.pbr-column--drop-hover {
    border-top-color: rgba(90, 160, 255, 0.9);
    background-color: rgba(90, 160, 255, 0.10);
}

.pbr-column-header {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0 6px;
    background-color: rgba(255, 255, 255, 0.04);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.35);
}

.pbr-column-header-icon {
    width: 14px;
    height: 14px;
    margin-right: 4px;
}

.pbr-column-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex-shrink: 1;
    min-width: 0;
}

.pbr-column-count {
    margin-left: 6px;
    font-size: 10px;
    opacity: 0.6;
    white-space: nowrap;
}

.pbr-column-dropzone {
    margin-left: auto;
    width: 18px;
    height: 16px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.28);
    align-items: center;
    justify-content: center;
    opacity: 0.6;
}

.pbr-column-dropzone-icon {
    width: 10px;
    height: 10px;
}

.pbr-column .unity-list-view {
    flex-grow: 1;
}

.pbr-column .unity-list-view__empty-label {
    display: none;
}

.pbr-column .unity-collection-view__item {
    padding: 0;
}

.pbr-column-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 12px;
}

.pbr-column-empty-icon {
    width: 20px;
    height: 20px;
    opacity: 0.35;
}

/* ---- 行 ---- */
.pbr-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 6px 0 4px;
}

.pbr-row-icon {
    width: 12px;
    height: 12px;
    margin-right: 4px;
    flex-shrink: 0;
}

.pbr-row-name {
    color: var(--unity-colors-default-text);
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.pbr-row--done .pbr-row-name {
    opacity: 0.55;
}

.pbr-row--done .pbr-row-icon {
    opacity: 0.8;
}

/* 未処理: 琥珀のリング（▶ は畳み記号と紛らわしいので使わない。配置済みは ✔ 画像） */
.pbr-row-icon--pending {
    width: 9px;
    height: 9px;
    margin-left: 2px;
    margin-right: 5px;
    border-radius: 5px;
    border-width: 1.5px;
    border-color: rgba(220, 180, 50, 0.85);
}

.pbr-row--header {
    background-color: rgba(0, 0, 0, 0.18);
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.35);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.35);
}

.pbr-row--header .pbr-row-name {
    font-size: 10px;
    opacity: 0.7;
}

/* 行のホバー操作（PBRemap の行アクションと同じ 22×18） */
.pbr-row-actions {
    flex-direction: row;
    flex-shrink: 0;
    margin-left: 4px;
    display: none;
}

.pbr-row:hover .pbr-row-actions {
    display: flex;
}

.pbr-row-actions--hidden, .pbr-row:hover .pbr-row-actions--hidden {
    display: none;
}

.pbr-row-action {
    width: 22px;
    height: 18px;
    padding: 0;
    margin: 0 0 0 2px;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
}

.pbr-row-action-icon {
    width: 12px;
    height: 12px;
}

.pbr-row-fold {
    width: 10px;
    height: 10px;
    margin-right: 2px;
    flex-shrink: 0;
    opacity: 0.6;
}

/* ============================================================
   ライトテーマ（.pbr-theme-light はルートに PBReplacerTheme.Apply が付ける）
   共通語彙（strip / chip / advanced）は PBReplacerCommon.uss 側で上書き済み。ここはメイン固有のみ
   ============================================================ */

.pbr-theme-light .pbr-node--clickable:hover {
    background-color: rgba(0, 0, 0, 0.06);
}

.pbr-theme-light .pbr-link-button {
    color: rgb(20, 90, 200);
}

.pbr-theme-light .pbr-link-button:hover {
    color: rgb(60, 125, 235);
}

.pbr-theme-light .pbr-body {
    border-color: rgba(0, 0, 0, 0.22);
}

.pbr-theme-light .pbr-rail {
    background-color: rgba(0, 0, 0, 0.06);
    border-right-color: rgba(0, 0, 0, 0.22);
}

.pbr-theme-light .pbr-rail-chip {
    border-color: rgba(0, 0, 0, 0.20);
    background-color: rgba(255, 255, 255, 0.55);
}

.pbr-theme-light .pbr-rail-chip:hover {
    background-color: rgba(0, 0, 0, 0.08);
}

.pbr-theme-light .pbr-rail-chip--pending {
    border-color: rgba(190, 130, 0, 0.8);
}

.pbr-theme-light .pbr-rail-chip--done {
    border-color: rgba(40, 150, 80, 0.7);
}

.pbr-theme-light .pbr-rail-badge {
    border-color: rgba(0, 0, 0, 0.30);
    background-color: rgb(238, 238, 238);
}

.pbr-theme-light .pbr-rail-badge--pending {
    background-color: rgb(175, 120, 20);
    border-color: rgba(0, 0, 0, 0);
}

.pbr-theme-light .pbr-rail-badge--done {
    background-color: rgb(238, 238, 238);
    border-color: rgb(40, 140, 60);
    color: rgb(30, 120, 50);
}

.pbr-theme-light .pbr-column {
    border-right-color: rgba(0, 0, 0, 0.22);
}

.pbr-theme-light .pbr-column--drop-hover {
    border-top-color: rgba(50, 120, 230, 0.9);
    background-color: rgba(50, 120, 230, 0.10);
}

.pbr-theme-light .pbr-column-header {
    background-color: rgba(0, 0, 0, 0.04);
    border-bottom-color: rgba(0, 0, 0, 0.22);
}

.pbr-theme-light .pbr-column-dropzone {
    border-color: rgba(0, 0, 0, 0.30);
}

.pbr-theme-light .pbr-row--header {
    background-color: rgba(0, 0, 0, 0.07);
    border-top-color: rgba(0, 0, 0, 0.18);
    border-bottom-color: rgba(0, 0, 0, 0.18);
}

.pbr-theme-light .pbr-row-icon--pending {
    border-color: rgba(190, 130, 0, 0.9);
}
